server {
    listen 80;
    server_name www.ruihuaconsulting.com ruihuaconsulting.com;

    # Redirect all HTTP requests to HTTPS with a 301 Moved Permanently response.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.ruihuaconsulting.com ruihuaconsulting.com;

    # SSL Certificate Paths
    # Ensure these paths are correct for your server environment
    ssl_certificate /etc/nginx/ssl/ruihuaconsulting.com.crt;
    ssl_certificate_key /etc/nginx/ssl/ruihuaconsulting.com.key;

    # SSL Configuration (Modern & Secure)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # HSTS (Strict-Transport-Security)
    # Ensures the browser always connects via HTTPS for the next 1 year (31536000 seconds)
    # includeSubDomains applies this rule to all subdomains
    # preload allows you to submit your site to the HSTS preload list
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # HTTP/2 Server Push (Optional optimization)
    # Example: http2_push /css/styles.css;

    # Security Headers (These are also handled by Helmet in Express, but Nginx layer adds redundancy)
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";

    # Proxy Configuration to Node.js App
    location / {
        proxy_pass http://localhost:3000; # Assuming your Node.js app runs on port 3000
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Pass real IP to the application (important for rate limiting)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static Assets Caching (Optional optimization)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
        proxy_pass http://localhost:3000;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}
