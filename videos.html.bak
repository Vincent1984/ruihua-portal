<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>视频中心 - 瑞华智策</title>
  <meta name="description" content="瑞华智策视频中心：产品演示、专家访谈、客户案例与直播回放。" />
  <link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<body class="bg-white text-slate-800 antialiased selection:bg-brand-100 selection:text-brand-900">
<main class="pt-28">
    <section id="video-hero" class="px-4 sm:px-6 lg:px-8 mb-10">
      <!-- 动态渲染视频Banner -->
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-2 mb-6" id="video-tabs" role="tablist" aria-label="视频分类">
        <!-- 动态生成分类Tab -->
      </div>
      <div id="videos-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 动态加载视频卡片 -->
      </div>
      <div class="flex justify-center mt-8" id="videos-pager"></div>
    </section>
  </main>
<script src="/js/main.js"></script>
  <script src="/js/image-loader.js"></script>
  <script src="/js/videos.js"></script>
</body>
<style type="text/tailwindcss">
  .vc-tab {
    @apply px-6 py-2.5 rounded-xl text-sm font-medium text-slate-600 bg-white border border-slate-200 hover:border-brand-400 hover:text-brand-600 hover:bg-brand-50/50 transition-all duration-300 shadow-sm relative overflow-hidden flex items-center gap-2;
  }
  .vc-tab::after {
    content: '';
    @apply absolute bottom-0 left-0 w-full h-0.5 bg-brand-500 scale-x-0 transition-transform duration-300 origin-right;
  }
  .vc-tab:hover::after {
    @apply scale-x-100 origin-left;
  }
  .vc-tab.active {
    @apply bg-brand-600 text-white border-brand-600 shadow-md shadow-brand-500/20 ring-4 ring-brand-500/10;
  }
  .vc-tab.active::after {
    @apply hidden;
  }
  .vc-tab:not(.active):hover {
    @apply -translate-y-0.5 shadow-md border-brand-200;
  }
</style>
</html>
